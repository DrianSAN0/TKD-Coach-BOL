{
  "expo": {
    "name": "TKD Coach BOL",
    "slug": "TKD-Coach-BOL",
    "scheme": "tkd-coach-bol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1E1E"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1E1E1E"
      },
      "package": "com.driansan.tkdcoachbol"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "expo-dev-client",
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tu galería para seleccionar videos.",
          "cameraPermission": "Necesitamos acceso a la cámara para grabar videos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "db25b8ef-541a-4595-8205-f2116a27f988"
      }
    }
  }
}